DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# One or more guild IDs (comma-separated)
DISCORD_GUILD_IDS=
# Legacy single guild:
DISCORD_GUILD_ID=
# Allowed LFG channel IDs (comma-separated)
LFG_CHANNEL_IDS=

# Postgres (local: localhost; VPS compose uses host postgres)
POSTGRES_USER=lfg
POSTGRES_PASSWORD=lfg
POSTGRES_DB=lfg
DATABASE_URL=postgresql+asyncpg://lfg:lfg@localhost:5432/lfg
TEST_DATABASE_URL=postgresql+asyncpg://lfg:lfg@localhost:5432/lfg_test
LOG_LEVEL=INFO
# LOG_JSON=true for structured JSON logs in production
LOG_JSON=false
# SENTRY_DSN= optional

LOBBY_TTL_MINUTES=45
EXPIRE_POLL_SECONDS=30
EMBED_DEBOUNCE_SECONDS=2
EXPIRED_MODE=edit
AUTO_FORMAT_MESSAGES=true
DEFAULT_LFG_MODE=Competitivo
EMBED_THUMBNAIL_URL=

GAMIFICATION_ENABLED=false
STATS_CHANNEL_ID=0
COMPLETION_MIN_SECONDS=180

PANEL_STICKY_ENABLED=true
PANEL_STICKY_COOLDOWN_SECONDS=30

# Multi-guild admin dashboard (OAuth + API in same process as bot)
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/discord/callback
SESSION_SECRET=change-me-in-production
PUBLIC_APP_URL=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
VALORANT_CATALOG_SYNC_HOURS=24

# Periodic embed reconciliation (active lobbies refreshed from DB)
RECONCILE_POLL_SECONDS=300

# VPS maintenance scripts (scripts/vps_*.py) — never commit real values
# VPS_HOST=
# VPS_USER=root
# VPS_SSH_PASSWORD=
# VPS_LFG_DIR=/root/lfg-test
