DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Um ou vários servidores (IDs separados por vírgula)
DISCORD_GUILD_IDS=
# Legado: se só usares um servidor, também podes usar DISCORD_GUILD_ID=
DISCORD_GUILD_ID=
# Canais LFG permitidos (IDs separados por vírgula)
LFG_CHANNEL_IDS=

DATABASE_URL=postgresql+asyncpg://lfg:lfg@localhost:5432/lfg
TEST_DATABASE_URL=postgresql+asyncpg://lfg:lfg@localhost:5432/lfg_test
LOG_LEVEL=INFO

LOBBY_TTL_MINUTES=45
EXPIRE_POLL_SECONDS=30
EMBED_DEBOUNCE_SECONDS=2
EXPIRED_MODE=edit
AUTO_FORMAT_MESSAGES=true
DEFAULT_LFG_MODE=Competitivo
# URL da imagem no canto do embed LFG (opcional)
EMBED_THUMBNAIL_URL=

# Gamificação (grupos completos → /perfil, ranking, roles LFG Recruta/Agente/Radiante)
GAMIFICATION_ENABLED=false
# 0 = ranking automático (domingo 21h Lisboa) em todos os LFG_CHANNEL_IDS
STATS_CHANNEL_ID=0
COMPLETION_MIN_SECONDS=180

# Painel «Criar grupo»: republicar no fim do canal quando outras mensagens o empurram
PANEL_STICKY_ENABLED=true
PANEL_STICKY_COOLDOWN_SECONDS=30
